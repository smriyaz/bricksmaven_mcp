# Optional for public search; required to retrieve members-only copy payloads.
BRICKSMAVEN_EMAIL=
BRICKSMAVEN_PASSWORD=
# Optional: directory of HTML pages saved from your logged-in library in Chrome.
# This avoids sharing your account password with the server.
BRICKSMAVEN_HTML_DIR=
# Defaults to .cache/bricksmaven next to package.json
BRICKSMAVEN_CACHE_DIR=
